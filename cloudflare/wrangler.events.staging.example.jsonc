{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "savia-events-staging",
  "main": "../workers/events-consumer.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SAVIA_ENVIRONMENT": "staging",
    "SAVIA_REQUIRE_DEDICATED_TENANT_DATA": "true",
    "SAVIA_ALLOW_RUNTIME_MIGRATIONS": "false",
    "BETTER_AUTH_URL": "https://savia-app-staging.REPLACE_WORKERS_SUBDOMAIN.workers.dev",
    "SAVIA_RELEASE": "REPLACE_GIT_SHA"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "savia-control-staging", "database_id": "REPLACE_STAGING_CONTROL_D1_ID" },
    { "binding": "TENANT_STARTER_DB", "database_name": "savia-tenant-starter-staging", "database_id": "REPLACE_STAGING_TENANT_D1_ID" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "savia-staging-fallback-disabled" },
    { "binding": "TENANT_STARTER_FILES", "bucket_name": "savia-tenant-starter-staging" }
  ],
  "vectorize": [
    { "binding": "TENANT_STARTER_VECTORS", "index_name": "savia-tenant-starter-staging-v1" }
  ],
  "queues": {
    "consumers": [{
      "queue": "savia-events-staging",
      "dead_letter_queue": "savia-events-dead-letter-staging",
      "max_batch_size": 10,
      "max_batch_timeout": 5,
      "max_retries": 5,
      "max_concurrency": 10
    }]
  },
  "durable_objects": {
    "bindings": [{ "name": "CONVERSATION_COORDINATOR", "class_name": "ConversationCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationCoordinator"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
