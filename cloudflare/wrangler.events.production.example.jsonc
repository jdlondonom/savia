{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "savia-events-production",
  "main": "../workers/events-consumer.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "server-only": "../workers/server-only.ts" },
  "vars": {
    "SAVIA_ENVIRONMENT": "production",
    "SAVIA_REQUIRE_DEDICATED_TENANT_DATA": "true",
    "SAVIA_ALLOW_RUNTIME_MIGRATIONS": "false",
    "BETTER_AUTH_URL": "https://app.example.com"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "savia-control-production", "database_id": "REPLACE_CONTROL_D1_ID" },
    { "binding": "TENANT_EXAMPLE_DB", "database_name": "savia-tenant-example-production", "database_id": "REPLACE_TENANT_D1_ID" }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "savia-local-fallback-disabled" },
    { "binding": "TENANT_EXAMPLE_FILES", "bucket_name": "savia-tenant-example-production" }
  ],
  "vectorize": [
    { "binding": "TENANT_EXAMPLE_VECTORS", "index_name": "savia-tenant-example-v1" }
  ],
  "queues": {
    "consumers": [{
      "queue": "savia-events-production",
      "dead_letter_queue": "savia-events-dead-letter-production",
      "max_batch_size": 10,
      "max_batch_timeout": 5,
      "max_retries": 5,
      "max_concurrency": 10
    }]
  },
  "durable_objects": {
    "bindings": [{ "name": "CONVERSATION_COORDINATOR", "class_name": "ConversationCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationCoordinator"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
